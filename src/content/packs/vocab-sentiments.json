  "lesson": [
    {
      "type": "p",
      "text": "Pour exprimer ce que tu ressens et décrire le caractère de quelqu'un, très utile à l'oral du B1."
    },
    {
      "type": "examples",
      "items": [
        {
          "de": "Ich bin ein bisschen nervös wegen der Prüfung.",
          "fr": "Je suis un peu nerveuse à cause de l'examen."
        },
        {
          "de": "Er ist sehr hilfsbereit.",
          "fr": "Il est très serviable."
        }
      ]
    },
    {
      "type": "tip",
      "text": "Beaucoup de sentiments se disent avec un verbe réfléchi : *sich freuen, sich ärgern, sich langweilen, sich Sorgen machen*."
    }
  ],
