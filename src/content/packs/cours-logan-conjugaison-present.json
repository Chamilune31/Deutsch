    },
    {
      "type": "table",
      "head": [
        "Inséparables (jamais séparés, pas de ge- au participe)",
        "Séparables (particule à la fin, ge- au milieu)"
      ],
      "rows": [
        [
          "**be**kommen, **er**halten, **ent**stehen, **ver**stehen, **ge**nehmigen, **zer**brechen, **miss**verstehen, **emp**fehlen",
          "**an**kommen, **auf**stehen, **ein**kaufen, **mit**kommen, **fern**sehen, **zurück**kommen"
        ]
      ]
    },
    {
      "type": "h",
      "text": "Les terminaisons régulières"
    },
    {
      "type": "table",
      "head": [
        "ich",
        "du",
        "er/sie/es",
        "wir",
        "ihr",
        "sie/Sie"
      ],
      "rows": [
        [
          "radical + **e**",
          "+ **st**",
          "+ **t**",
          "+ **en**",
          "+ **t**",
          "+ **en**"
        ],
        [
          "mache",
          "machst",
          "macht",
          "machen",
          "macht",
          "machen"
        ]
      ]
    },
    {
      "type": "h",
      "text": "Cas particuliers"
    },
    {
      "type": "table",
      "head": [
        "Verbe",
        "Règle",
        "Exemples"
      ],
      "rows": [
        [
          "radical en **-t / -d**",
          "on ajoute un **e** devant -st et -t (du, er, ihr)",
          "arbeiten → du arbeit**e**st, er arbeit**e**t, ihr arbeit**e**t ; binden → du bind**e**st"
        ],
        [
          "radical en **-m / -n** après une consonne",
          "même règle (sauf après l, r, h)",
          "atmen → du atm**e**st ; öffnen → er öffn**e**t ; mais lernen → du lernst"
        ],
        [
          "en **-eln**",
          "le **e** du radical tombe souvent à *ich*",
          "wechseln → ich wechs**le** (ou wechsele), du wechselst"
        ],
        [
          "**e → i / ie** (verbes forts)",
          "changement de voyelle à *du* et *er/sie/es* seulement",
          "sprechen → du spr**i**chst, er spr**i**cht ; lesen → du l**ie**st ; sehen → du s**ie**hst"
        ],
        [
          "**a → ä**, **au → äu**",
          "idem",
          "fahren → du f**ä**hrst ; laufen → er l**äu**ft"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Le changement de voyelle ne touche **jamais** *ihr* : *ihr sprecht, ihr lest, ihr seht*."
    }
  ],
