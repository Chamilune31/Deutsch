  "lesson": [
    {
      "type": "p",
      "text": "Un verbe réfléchi s'accompagne d'un pronom qui renvoie au sujet. Au Perfekt, il prend **haben** (contrairement au français : *je me suis levée*)."
    },
    {
      "type": "table",
      "head": [
        "Sujet",
        "Pronom réfléchi (accusatif)"
      ],
      "rows": [
        [
          "ich",
          "mich"
        ],
        [
          "du",
          "dich"
        ],
        [
          "er/sie/es",
          "sich"
        ],
        [
          "wir",
          "uns"
        ],
        [
          "ihr",
          "euch"
        ],
        [
          "sie/Sie",
          "sich"
        ]
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "de": "Ich **freue mich** auf die Ferien.",
          "fr": "Je me réjouis des vacances (à venir)."
        },
        {
          "de": "Wir **haben uns** gestern **getroffen**.",
          "fr": "Nous nous sommes vus hier."
        },
        {
          "de": "**Erinnerst du dich** an ihn?",
          "fr": "Tu te souviens de lui ?"
        }
      ]
    },
    {
      "type": "tip",
      "text": "Attention aux prépositions : *sich freuen **auf*** (à venir) / ***über*** (déjà là), *sich erinnern **an***, *sich interessieren **für***."
    }
  ],
