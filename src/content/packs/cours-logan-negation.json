    },
    {
      "type": "mcq",
      "q": "Er hat ___ Bruder.",
      "options": [
        "keinen",
        "kein",
        "keinem"
      ],
      "answer": 0,
      "why": "Accusatif masculin → **keinen**."
    },
    {
      "type": "mcq",
      "q": "Ich spiele mit ___ Kind.",
      "options": [
        "keinem",
        "keinen",
        "kein"
      ],
      "answer": 0,
      "why": "*mit* + datif neutre → **keinem**."
    },
    {
      "type": "mcq",
      "q": "Das Essen ist ___ gut.",
      "options": [
        "nicht",
        "kein",
        "keine"
      ],
      "answer": 0,
      "why": "On nie un adjectif → **nicht**."
    },
    {
      "type": "order",
      "answers": [
        "Ich habe heute nicht gearbeitet"
      ],
      "why": "*nicht* devant le participe passé."
    },
    {
      "type": "translate",
      "dir": "fr-de",
      "q": "Je ne mange pas de viande.",
      "answers": [
        "Ich esse kein Fleisch."
      ],
      "why": "das Fleisch, sans article → **kein** Fleisch."
    }
  ],
