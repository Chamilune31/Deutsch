  "lesson": [
    {
      "type": "h",
      "text": "Trois verbes, trois cas"
    },
    {
      "type": "table",
      "head": [
        "Verbe",
        "Cas",
        "Exemple"
      ],
      "rows": [
        [
          "**sein** (être)",
          "nominatif",
          "Ich bin **ein netter** Mann."
        ],
        [
          "**treffen** (rencontrer, retrouver)",
          "accusatif",
          "Ich treffe **einen netten** Mann."
        ],
        [
          "**begegnen** (croiser, rencontrer par hasard)",
          "**datif**",
          "Ich begegne **einem netten** Mann."
        ]
      ]
    },
    {
      "type": "tip",
      "text": "*treffen* = rencontrer (souvent un rendez-vous prévu) + accusatif. *begegnen* = croiser par hasard + **datif**, et au Perfekt avec **sein** : *Ich **bin** ihm **begegnet**.*"
    },
    {
      "type": "h",
      "text": "Après l'article défini (der, die, das)"
    },
    {
      "type": "p",
      "text": "L'article montre déjà le genre et le cas : l'adjectif prend juste **-e** ou **-en**."
    },
    {
      "type": "table",
      "head": [
        "",
        "Masculin",
        "Féminin",
        "Neutre",
        "Pluriel"
      ],
      "rows": [
        [
          "Nominatif (sein)",
          "der nett**e** Mann",
          "die nett**e** Frau",
          "das nett**e** Mädchen",
          "die nett**en** Leute"
        ],
        [
          "Accusatif (treffen)",
          "den nett**en** Mann",
          "die nett**e** Frau",
          "das nett**e** Mädchen",
          "die nett**en** Leute"
        ],
        [
          "Datif (begegnen)",
          "dem nett**en** Mann",
